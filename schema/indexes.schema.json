{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/kaso/1.0/indexes.schema.json",
  "title": "indexes v1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "indexes"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "records"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "index_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "object_ref": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "oracle_name": {
          "type": "string",
          "minLength": 1
        },
        "uniqueness": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "function_based": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "common.schema.json#/$defs/status"
        },
        "evidence_refs": {
          "$ref": "common.schema.json#/$defs/refs"
        },
        "limitations_sk": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "column_or_expression_entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "position": {
                "type": "integer",
                "minimum": 1
              },
              "field_ref": {
                "$ref": "common.schema.json#/$defs/ref"
              },
              "expression_raw": {
                "type": "string",
                "minLength": 1
              },
              "direction": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "position"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "field_ref"
                ],
                "not": {
                  "required": [
                    "expression_raw"
                  ]
                }
              },
              {
                "required": [
                  "expression_raw"
                ],
                "not": {
                  "required": [
                    "field_ref"
                  ]
                }
              }
            ]
          }
        }
      },
      "required": [
        "index_id",
        "object_ref",
        "oracle_name",
        "status",
        "evidence_refs",
        "column_or_expression_entries"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "POTVRDENÉ"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            },
            "required": [
              "evidence_refs"
            ]
          }
        }
      ]
    }
  }
}
