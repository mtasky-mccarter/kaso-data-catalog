    "object_type": {
      "type": "string",
      "minLength": 1
    },
    "business_object_sk": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "purpose_sk": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "grain_sk": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "maturity": {
      "$ref": "common.schema.json#/$defs/maturity"
