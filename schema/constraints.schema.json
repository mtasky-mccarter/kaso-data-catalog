{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/kaso/1.0/constraints.schema.json",
  "title": "constraints v1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "constraints"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "records"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "constraint_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "object_ref": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "oracle_name": {
          "type": "string",
          "minLength": 1
        },
        "constraint_type": {
          "type": "string",
          "minLength": 1
        },
        "column_refs": {
          "$ref": "common.schema.json#/$defs/refs"
        },
        "referenced_object_ref": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "referenced_column_refs": {
          "$ref": "common.schema.json#/$defs/refs"
        },
        "enabled_state": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "validated_state": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "common.schema.json#/$defs/status"
        },
        "evidence_refs": {
          "$ref": "common.schema.json#/$defs/refs"
        },
        "search_condition_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "delete_rule": {
          "type": [
            "string",
            "null"
          ]
        },
        "referenced_owner_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "referenced_constraint_name_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "generated_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "deferrable_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "deferred_raw": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "constraint_id",
        "object_ref",
        "oracle_name",
        "constraint_type",
        "column_refs",
        "status",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "POTVRDENÉ"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            },
            "required": [
              "evidence_refs"
            ]
          }
        }
      ]
    }
  }
}
