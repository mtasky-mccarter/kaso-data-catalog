{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/kaso/1.0/contract.schema.json",
  "title": "contract v1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "contract"
    },
    "contract_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "title_sk": {
      "type": "string",
      "minLength": 1
    },
    "purpose_sk": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "scope_includes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope_excludes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authoritative_environment": {
      "type": "string",
      "minLength": 1
    },
    "authoritative_owner": {
      "type": "string",
      "minLength": 1
    },
    "maturity": {
      "$ref": "common.schema.json#/$defs/maturity"
    },
    "object_refs": {
      "$ref": "common.schema.json#/$defs/refs"
    },
    "component_refs": {
      "$ref": "common.schema.json#/$defs/refs"
    },
    "boundary_refs": {
      "$ref": "common.schema.json#/$defs/refs"
    },
    "evidence_refs": {
      "$ref": "common.schema.json#/$defs/refs"
    },
    "limitations_sk": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "contract_id",
    "domain",
    "title_sk",
    "purpose_sk",
    "scope_includes",
    "scope_excludes",
    "authoritative_environment",
    "authoritative_owner",
    "maturity",
    "object_refs",
    "component_refs",
    "boundary_refs",
    "evidence_refs",
    "limitations_sk"
  ],
  "additionalProperties": false
}
