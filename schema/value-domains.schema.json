{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/kaso/1.0/value-domains.schema.json",
  "title": "value-domains v1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "value-domains"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "records"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "value_domain_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "scope_ref": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "raw_value": {
          "$ref": "common.schema.json#/$defs/raw_scalar"
        },
        "canonical_value": {
          "$ref": "common.schema.json#/$defs/raw_scalar"
        },
        "business_label_sk": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_constant_ref": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_live": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_date": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "common.schema.json#/$defs/status"
        },
        "evidence_refs": {
          "$ref": "common.schema.json#/$defs/refs"
        },
        "limitations_sk": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "value_domain_id",
        "scope_ref",
        "status",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "POTVRDENÉ"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            },
            "required": [
              "evidence_refs"
            ]
          }
        }
      ]
    }
  }
}
