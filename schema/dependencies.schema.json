{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/kaso/1.0/dependencies.schema.json",
  "title": "dependencies v1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "dependencies"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "records"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "dependency_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "source_ref": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "target_ref": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "oracle_object_type": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "direction": {
          "type": "string",
          "minLength": 1
        },
        "depth": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "$ref": "common.schema.json#/$defs/dependency_role"
        },
        "discovery_method": {
          "type": "string",
          "minLength": 1
        },
        "source_visible": {
          "type": "boolean"
        },
        "runtime_boundary": {
          "type": "boolean"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/status"
        },
        "evidence_refs": {
          "$ref": "common.schema.json#/$defs/refs"
        },
        "limitations_sk": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "dependency_id",
        "source_ref",
        "target_ref",
        "direction",
        "depth",
        "role",
        "discovery_method",
        "source_visible",
        "runtime_boundary",
        "status",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "POTVRDENÉ"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            },
            "required": [
              "evidence_refs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "enum": [
                  "DIRECT WRITER",
                  "API WRITER",
                  "READER",
                  "CALLER"
                ]
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              },
              "status": {
                "not": {
                  "const": "DEPENDENCY ONLY"
                }
              }
            }
          }
        }
      ]
    }
  }
}
