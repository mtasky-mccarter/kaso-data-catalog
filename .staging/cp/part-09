def main():
    root=Path(__file__).resolve().parents[1]
    data=base64.b64decode(PAYLOAD)
    with tarfile.open(fileobj=io.BytesIO(data),mode="r:gz") as tf:
        for member in tf.getmembers():
            target=(root/member.name).resolve()
            if root.resolve() not in target.parents:
                raise RuntimeError(f"unsafe path: {member.name}")
        tf.extractall(root)
    sql_registry = root / "catalog/transport/cestovne-prikazy/sql-registry.yaml"
    text = sql_registry.read_text(encoding="utf-8")
    text = text.replace(
        "    sql_client: SQL Navigator 5.5.4.847\n    read_only: true",
        "    sql_client: SQL Navigator 5.5.4.847\n    oracle_server_version: null\n    read_only: true",
    )
    sql_registry.write_text(text, encoding="utf-8")

if __name__=="__main__": main()
