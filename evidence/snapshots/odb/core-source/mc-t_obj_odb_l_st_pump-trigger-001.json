    "TEXT": " AFTER\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 3,
    "TEXT": "   INSERT OR DELETE OR UPDATE OF rid, flags_s, suma_m, datum_p, s_stamp, id\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 4,
    "TEXT": " ON OBJ_ODB_L\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 5,
    "TEXT": "REFERENCING NEW AS NEW OLD AS OLD\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 6,
    "TEXT": " FOR EACH ROW\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 7,
    "TEXT": "Begin\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 8,
    "TEXT": "  if inserting\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 9,
    "TEXT": "  then\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 10,
    "TEXT": "    If :new.id > 0\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 11,
    "TEXT": "    then\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 12,
    "TEXT": "      st_pump_kontrola(psTab => 'OBJ_ODB_L', pdtDatum => :new.datum);\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 13,
    "TEXT": "      st_pump_zmena(psTab => 'OBJ_ODB_L', pdtDatum => :new.datum);\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 14,
    "TEXT": "    end if;\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 15,
    "TEXT": "  end if;\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 16,
    "TEXT": "\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 17,
    "TEXT": "  if updating\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 18,
    "TEXT": "  then\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 19,
    "TEXT": "    If :new.id > 0\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 20,
    "TEXT": "       and(:old.datum_p != :new.datum_p\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 21,
    "TEXT": "           or :old.s_stamp != :new.s_stamp\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 22,
    "TEXT": "           or :old.id != :new.id\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 23,
    "TEXT": "           or :old.suma_m != :new.suma_m\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 24,
    "TEXT": "           --or nvl(:old.kod_o, 'XXXYZ') != nvl(:new.kod_o, 'XXXYZ')\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 25,
    "TEXT": "           --or :old.obsluha != :new.obsluha\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 26,
    "TEXT": "           --or :old.uct_str != :new.uct_str\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 27,
    "TEXT": "           --or :old.zakazka != :new.zakazka\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 28,
    "TEXT": "           or nvl(substr(:old.flags_s, 12,1),'0') != nvl(substr(:new.flags_s, 12,1),'0')   -- stav vyb\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 29,
    "TEXT": "           )\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 30,
    "TEXT": "    then\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 31,
    "TEXT": "      st_pump_kontrola(psTab => 'OBJ_ODB_L', pdtDatum => least(:old.datum, :new.datum));\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 32,
    "TEXT": "      st_pump_zmena(psTab => 'OBJ_ODB_L', pdtDatum => least(:old.datum, :new.datum));\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 33,
    "TEXT": "    end if;\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 34,
    "TEXT": "  end if;\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 35,
    "TEXT": "\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 36,
    "TEXT": "  if deleting\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 37,
    "TEXT": "  then\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 38,
    "TEXT": "    if :old.id > 0\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 39,
    "TEXT": "    then\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 40,
    "TEXT": "      st_pump_kontrola(psTab => 'OBJ_ODB_L', pdtDatum => :old.datum);\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 41,
    "TEXT": "      st_pump_zmena(psTab => 'OBJ_ODB_L', pdtDatum => :old.datum);\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_L_ST_PUMP",
    "TYPE": "TRIGGER",
    "LINE": 42,
