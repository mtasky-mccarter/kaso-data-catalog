    "TYPE": "TRIGGER",
    "LINE": 1,
    "TEXT": "TRIGGER t_obj_odb_o_ct_limit_obj\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 2,
    "TEXT": " BEFORE\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 3,
    "TEXT": "   INSERT OR DELETE OR UPDATE OF p_del_dod, pocet, p_del, rid_ct_a\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 4,
    "TEXT": " ON obj_odb_o\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 5,
    "TEXT": "REFERENCING NEW AS NEW OLD AS OLD\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 6,
    "TEXT": " FOR EACH ROW\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 7,
    "TEXT": "begin  \n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 8,
    "TEXT": "  if c_session.GetBeziTemp2ObjOdb = 1 then\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 9,
    "TEXT": "    return;\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 10,
    "TEXT": "  end if;\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 11,
    "TEXT": "  -- kontroly\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 12,
    "TEXT": "  if inserting then  \n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 13,
    "TEXT": "    if :new.rid_ct_a = '0' then          \n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 14,
    "TEXT": "      return;  \n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 15,
    "TEXT": "    end if; \n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 16,
    "TEXT": "  elsif updating then\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 17,
    "TEXT": "    if :new.rid_ct_a = '0' and :old.rid_ct_a = '0' then             \n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 18,
    "TEXT": "      return;\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 19,
    "TEXT": "    end if;\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 20,
    "TEXT": "  else -- deleting\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 21,
    "TEXT": "    if :old.rid_ct_a = '0' then         \n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 22,
    "TEXT": "      return;\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 23,
    "TEXT": "    end if;  \n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 24,
    "TEXT": "  end if;\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 25,
    "TEXT": "  \n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 26,
    "TEXT": "  ----------------------------------------------------------------------------------- \n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 27,
    "TEXT": "  if inserting then  \n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 28,
    "TEXT": "    c_cenotvorba_o.NastavPocetAkcieObjOdb(psRID_CT_A=>:new.rid_ct_a, pnPocet=>(:new.pocet-:new.p_del-:new.p_del_dod)); \n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 29,
    "TEXT": "  end if;  \n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 30,
    "TEXT": "  if updating then\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 31,
    "TEXT": "    if :new.rid_ct_a = :old.rid_ct_a then\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 32,
    "TEXT": "      if (:new.pocet != :old.pocet or :new.p_del != :old.p_del or :new.p_del_dod != :old.p_del_dod) then     \n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 33,
    "TEXT": "        c_cenotvorba_o.NastavPocetAkcieObjOdb(psRID_CT_A=>:new.rid_ct_a, \n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 34,
    "TEXT": "          pnPocet=>((:new.pocet-:new.p_del-:new.p_del_dod) - (:old.pocet-:old.p_del-:old.p_del_dod)));     \n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 35,
    "TEXT": "      end if;\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 36,
    "TEXT": "    elsif :new.rid_ct_a != :old.rid_ct_a then\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 37,
    "TEXT": "      c_cenotvorba_o.NastavPocetAkcieObjOdb(psRID_CT_A=>:old.rid_ct_a, pnPocet=>-(:old.pocet-:old.p_del-:old.p_del_dod));     \n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 38,
    "TEXT": "      c_cenotvorba_o.NastavPocetAkcieObjOdb(psRID_CT_A=>:new.rid_ct_a, pnPocet=>(:new.pocet-:new.p_del-:new.p_del_dod));     \n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 39,
    "TEXT": "    end if;\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 40,
    "TEXT": "  end if;\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 41,
    "TEXT": "  if deleting then  \n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 42,
    "TEXT": "    c_cenotvorba_o.NastavPocetAkcieObjOdb(psRID_CT_A=>:old.rid_ct_a, pnPocet=>-(:old.pocet-:old.p_del-:old.p_del_dod)); \n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 43,
    "TEXT": "  end if;\n"
  },
  {
    "OWNER": "MC",
    "NAME": "T_OBJ_ODB_O_CT_LIMIT_OBJ",
    "TYPE": "TRIGGER",
    "LINE": 44,
    "TEXT": "end;\n"
  }
]
